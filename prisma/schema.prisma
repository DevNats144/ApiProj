// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}


  datasource db {
  provider = "mongodb"
}


model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  age Int
  email String @unique

}

